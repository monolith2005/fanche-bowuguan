{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,tools/**,docs/**,runtime/**,node_modules/**,assets/**,web/**,miniprogram_npm/**}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/web/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    }
  ]
}
