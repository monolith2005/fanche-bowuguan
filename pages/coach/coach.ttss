.coach-head { display:flex; justify-content:space-between; align-items:flex-start; }
.small { font-size:48rpx; margin-top:10rpx; }
.counter { font-family:serif; font-size:34rpx; color:#d95d39; }
.progress-bar { height:10rpx; background:#ded4c6; border-radius:99rpx; overflow:hidden; margin:20rpx 0 34rpx; }
.progress-bar view { height:100%; background:#d95d39; transition:.3s; }
.step-card { padding:34rpx; min-height:250rpx; display:flex; flex-direction:column; justify-content:center; }
.step-label { color:#d95d39; font-size:21rpx; letter-spacing:3rpx; font-weight:700; }
.step-copy { font-family:serif; font-size:40rpx; font-weight:800; line-height:1.55; margin:18rpx 0; }
.verify-card { margin:20rpx 0; padding:26rpx; }
.verify-title { font-weight:800; font-size:30rpx; margin-bottom:8rpx; }
.verify-card .muted { font-size:21rpx; line-height:1.5; }
.photo-box { height:300rpx; border:2rpx dashed #b9ad9d; border-radius:20rpx; margin:22rpx 0 14rpx; display:flex; align-items:center; justify-content:center; text-align:center; color:#7c7368; overflow:hidden; }
.photo-box image { width:100%; height:100%; }
.photo-box text { display:block; color:#d95d39; font-size:54rpx; margin-bottom:10rpx; }
.result { margin-top:16rpx; padding:20rpx; background:#e9f2e7; color:#446044; border-radius:16rpx; }
.result.offline { background:#f4ecdf; color:#765b45; }
.result view { font-weight:800; margin-bottom:7rpx; }
.result text { font-size:22rpx; line-height:1.5; }
.finish-card { margin-top:60rpx; padding:40rpx 30rpx; text-align:center; }
.seal { margin:0 auto 28rpx; width:110rpx; height:110rpx; border-radius:50%; border:6rpx double #d95d39; color:#d95d39; display:flex; align-items:center; justify-content:center; font-family:serif; font-size:48rpx; font-weight:800; transform:rotate(-8deg); }
.finish-title { font-size:46rpx; margin-bottom:18rpx; }
.finish-card>.muted { line-height:1.6; }
.summary { display:grid; grid-template-columns:100rpx 1fr; gap:16rpx; text-align:left; margin:30rpx 0; padding:24rpx; background:#f5eee3; border-radius:18rpx; line-height:1.5; }
.summary>text { color:#8f8477; }
